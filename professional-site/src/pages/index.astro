---
import Base from '../layouts/Base.astro';

// ✏️ EDIT EVERYTHING IN THIS BLOCK
const me = {
  name: 'Elana Tolliu',
  email: 'elana.tolliu@gmail.com',
  site: 'https://elana.tolliu.pro', // must match `site` in astro.config.mjs
  // Links to your other profiles: helps search engines and LLMs connect them to you
  profiles: [
    'https://voice123.com/YOUR-PROFILE',
    'https://www.fiverr.com/YOUR-PROFILE',
  ],
  business: 'Elana Tolliu (enskild firma) · Org.nr 800722-3848 · VAT SE800722384801 · Registered for F-skatt',
  turnaround: '1–3 business days for scripts up to 1,500 words',
};

// Put MP3 files (192 kbps) in /public/demos. Duration is ISO 8601: PT0M45S = 45 seconds.
// `transcript` is optional but valuable: search engines and LLMs cannot hear audio.
const demos = [
  {
    title: 'Customer data security',
    kind: 'Corporate training',
    desc: 'How a company protects customer data, explained clearly for employees.',
    src: '/media/voice-over/corporation_2026-11-14.mp3',
    duration: 'PT1M32S',
    transcript: '',
  },
  {
    title: 'Setting up your equipment',
    kind: 'Instructional',
    desc: 'Step-by-step equipment setup guide with clear, even pacing.',
    src: '/media/voice-over/instruction_2026-11-14.mp3',
    duration: 'PT1M18S',
    transcript: '',
  },
  {
    title: 'Writing and Socrates',
    kind: 'Storytelling and lecture',
    desc: 'An entertaining lecture about writing and Socrates.',
    src: '/media/voice-over/lection_2026-11-14.mp3',
    duration: 'PT1M33S',
    transcript: '',
  },
  {
    title: 'The Golden Age of Russian literature',
    kind: 'Educational',
    desc: 'An introduction to the Golden Age of Russian literature.',
    src: '/media/voice-over/study_2026-11-14.mp3',
    duration: 'PT1M51S',
    transcript: '',
  },
];

const description =
  'Native Russian voice over artist based in Sweden. E-learning, corporate training, instructional videos, documentaries and non-fiction narration. Listen to demos and request a quote.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${me.site}/#me`,
      name: me.name,
      jobTitle: 'Voice actor',
      url: me.site,
      email: me.email,
      knowsLanguage: 'ru',
      address: { '@type': 'PostalAddress', addressCountry: 'SE' },
      sameAs: me.profiles,
    },
    {
      '@type': 'Service',
      '@id': `${me.site}/#service`,
      name: 'Russian voice over',
      serviceType: 'Voice over and narration in Russian',
      provider: { '@id': `${me.site}/#me` },
      areaServed: 'Worldwide',
      description,
    },
    ...demos.map((d) => ({
      '@type': 'AudioObject',
      name: `${d.title} (${d.kind})`,
      description: d.desc,
      contentUrl: new URL(d.src, me.site).href,
      encodingFormat: 'audio/mpeg',
      duration: d.duration,
      inLanguage: 'ru',
      creator: { '@id': `${me.site}/#me` },
    })),
  ],
};
---
<Base title={`Russian voice over artist: e-learning, corporate, documentary | ${me.name}`} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="top">
      <a class="brand" href="/">{me.name}</a>
      <nav aria-label="Main">
        <a href="#demos">Demos</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <div class="hero">
        <h1>Native Russian voice for things that need explaining.</h1>
        <p class="lede">
          I narrate e-learning, corporate training, instructional videos and documentaries in Russian,
          recorded in my own studio in Sweden.
        </p>
        <p class="lede ru" lang="ru">Русский голос для обучения, инструкций и документальных историй.</p>
        <div class="actions">
          <a class="btn" target="_blank" rel="noopener noreferrer" href={`https://www.fiverr.com/s/vbrRkrr`}>Order on Fiverr</a>
          <a class="btn alt" href={`mailto:${me.email}?subject=Russian%20voice%20over%20project`}>Email for Custom Projects</a>
          <a class="btn alt" href="#demos">Listen to demos</a>
        </div>
      </div>
    </main>
  </div>

  <section id="demos">
    <div class="wrap">
      <h2>Demos</h2>
      {demos.map((d) => (
        <article class="demo">
          <div>
            <h3>{d.title}</h3>
            <p class="kind">{d.kind}</p>
            <p>{d.desc}</p>
          </div>
          <div>
            <audio controls preload="none" src={d.src} aria-label={`${d.title}: ${d.kind} demo`}></audio>
            {d.transcript && (
              <details>
                <summary>Read the transcript</summary>
                <p lang="ru">{d.transcript}</p>
              </details>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <h2>What I voice in Russian</h2>
      <ul class="plain">
        <li><strong>E-learning and corporate training:</strong> compliance, security, onboarding, internal videos.</li>
        <li><strong>Instructional and product videos:</strong> setup guides, how-tos, software and hardware walkthroughs.</li>
        <li><strong>Documentary and educational narration:</strong> lectures, history, culture, science.</li>
        <li><strong>Non-fiction audiobooks:</strong> popular science, history and literature.</li>
      </ul>
    </div>
  </section>

  <section class="faq">
    <div class="wrap">
      <h2>Questions clients ask</h2>
      <details>
        <summary>What do I receive?</summary>
        <p>A clean WAV file, 48 kHz / 24-bit, mono (or dual mono if you need it). MP3 on request. Retakes for mispronunciations are included.</p>
      </details>
      <details>
        <summary>How fast can you deliver?</summary>
        <p>Typical turnaround: {me.turnaround}. Rush delivery is possible, so ask.</p>
      </details>
      <details>
        <summary>How is the price calculated?</summary>
        <p>By finished audio length or word count, plus usage. Send the script and the intended use, and I will reply with a fixed quote.</p>
      </details>
      <details>
        <summary>Do you invoice companies in the EU?</summary>
        <p>Yes. I work as a registered Swedish sole proprietor (enskild firma), approved for F-skatt, and issue proper invoices with VAT handled according to Swedish rules.</p>
      </details>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <h2>Send me your script</h2>
      <p>Tell me the word count, where the audio will be used, and your deadline. I answer within one business day.</p>
      <p><a class="btn" href={`mailto:${me.email}?subject=Russian%20voice%20over%20project`}>{me.email}</a></p>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <p>{me.business}</p>
    </div>
  </footer>
</Base>
