---
import Base from '../layouts/Base.astro';
import { site, personLd } from '../data/site';

const b = site.business;
const title = 'Privacy and data protection | Elana Tolliu';
const description =
  'How Elana Tolliu handles personal data: this website uses no cookies or analytics, and only processes the information you send by email to deliver and invoice your project.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [{ ...personLd }, { '@type': 'WebPage', name: title, url: `${site.url}/privacy-and-data-protection/`, dateModified: '2026-11-22' }],
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap prose">
    <div class="page-title">
      <h1>Privacy and data protection</h1>
      <p class="note">Last updated: 22 November 2026</p>
    </div>

    <h2>Who is responsible</h2>
    <p>
      The controller of personal data is {b.legalName}, Org.nr {b.orgNr}, {b.street}, {b.postalCode} {b.city}, {b.country}.
      Contact: <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>

    <h2>This website</h2>
    <p>
      This website has no contact form, no cookies, no analytics and no advertising or tracking tools.
      Fonts are served from this site, not from a third party. Like any web host, the hosting provider
      (Amazon Web Services) may keep technical server logs, such as IP address and
      requested page, for security and operation.
    </p>

    <h2>What I collect and why</h2>
    <p>I only receive personal data when you contact me, for example by email. This may include:</p>
    <ul>
      <li>your name, email address and company details;</li>
      <li>the content of your message and any texts or scripts you send for a quote or a project;</li>
      <li>invoicing details, if we agree on a project.</li>
    </ul>
    <p>
      I use this data to answer your enquiry, carry out the work and issue invoices. The legal bases are
      taking steps at your request before a contract and performing the contract (GDPR Art. 6(1)(b)),
      my legal obligations such as bookkeeping (Art. 6(1)(c)), and my legitimate interest in handling
      business correspondence (Art. 6(1)(f)).
    </p>

    <h2>Who receives it</h2>
    <p>
      Email is handled by Google (Gmail). I do not sell your data or use it for marketing. Texts you send
      are used only for your project and are not shared with others without your agreement. If you contact
      me through a marketplace such as Fiverr, that platform processes your data under its own privacy policy.
    </p>

    <h2>How long I keep it</h2>
    <p>
      Enquiries that do not lead to a project are deleted within a reasonable time. Accounting records,
      such as invoices, are kept for seven years as required by Swedish bookkeeping law. Project files
      are deleted when they are no longer needed, or earlier on request.
    </p>

    <h2>Your rights</h2>
    <p>
      You can ask for access to your data, correction, deletion, restriction or a copy of it, and you can
      object to processing based on legitimate interest. Write to <a href={`mailto:${site.email}`}>{site.email}</a>.
      You also have the right to complain to the Swedish Authority for Privacy Protection (IMY),&nbsp;
      <a href="https://www.imy.se" rel="noopener">imy.se</a>.
    </p>

    <h2>Changes</h2>
    <p>If this policy changes, the new version will be published on this page with an updated date.</p>
  </div>
</Base>
